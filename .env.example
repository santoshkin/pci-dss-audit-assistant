# Ollama (LLM + embeddings). On a split dev/test topology like this project's
# current one, Ollama runs on the same machine as the GPU, not necessarily
# where the API process runs.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=16384
EMBEDDING_MODEL=bge-m3

# Reranker: local process (FlagEmbedding), NOT served via Ollama (Ollama has
# no cross-encoder rerank API as of this writing). Lazily loaded onto GPU on
# first request and unloaded after RERANKER_IDLE_TIMEOUT_SECONDS of no use,
# since the GPU is shared with other services.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_IDLE_TIMEOUT_SECONDS=300
RERANKER_DEVICE=cuda

# Qdrant (dense + sparse hybrid search, single collection with fusion)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pci_dss_knowledge_base

# Postgres (audit projects, findings, requirement status, report runs)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pci_rag
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pci_rag

# Retrieval
TOP_K=20
RERANK_TOP_K=10
# Below this rerank score, refuse to answer instead of guessing (ТЗ п.20).
# Placeholder until calibrated against the evaluation dataset (ТЗ п.19).
MIN_RETRIEVAL_SCORE=0.35

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Data
DATA_DIR=./data

# Logging
LOG_LEVEL=INFO
